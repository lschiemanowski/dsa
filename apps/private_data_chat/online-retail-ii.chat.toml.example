# Copy this file to private-data-chat.toml in the repository root, then replace
# the database path, model names, and immutable Docker image digest as needed.
# Provider credentials and endpoints belong in environment variables, not here.

format = "dsa-private-data-chat-config/v1"
data_source_id = "online_retail_ii"
mock_context_path = "apps/private_data_chat/mock-database.example.json"
database_path = "data/online-retail-ii/1.0.0/database/online_retail_ii.duckdb"
runs_directory = ".private-data-chat/runs"
docker_image = "dsa-python@sha256:replace-with-local-image-digest"
enable_analysis_guidance = false
report_to_mlflow = false

# Public, dataset-owned DuckDB card. The exact commit and digest are required.
[database_card]
format = "dsa-huggingface-database-card/v1"
repo_id = "lschiemanowski/dsa-datasets"
revision = "a8d4bd60c13265fdd938cf8393d332fda5fb6910"
path = "online-retail-ii/1.0.0/database-card.json"
sha256 = "874d0d0512b0a7878663512aa1fdd41db0fdd720b2fd42c89126092b98d7d0fe"

# This model receives only bounded conversation text, the public card, and synthetic rows.
[clarifier]
model = "openrouter:deepseek/deepseek-v4-flash-0731"
settings = { thinking = "medium" }

# This separately configured model is invoked only after exact user approval.
[trusted]
model = "openai-chat:local-dsa-model"
settings = { thinking = "medium" }
