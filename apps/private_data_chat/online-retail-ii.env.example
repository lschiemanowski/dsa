# Source this file from the repository root after replacing the marked local values.
# Export OPENROUTER_API_KEY separately; credentials do not belong in this file.

export DSA_CHAT_DATA_SOURCE_ID=online_retail_ii
export DSA_CHAT_MOCK_CONTEXT_PATH="$PWD/apps/private_data_chat/mock-database.example.json"

# The remote clarifier sees only synthetic context and bounded chat text.
export DSA_CHAT_CLARIFIER_MODEL_NAME='openrouter:deepseek/deepseek-v4-flash-0731'
export DSA_CHAT_CLARIFIER_MODEL_SETTINGS_JSON='{"thinking":"medium"}'

# This must be a verified regular database file, not a Hugging Face snapshot symlink.
export DSA_CHAT_DATABASE_PATH='/absolute/path/to/online_retail_ii.duckdb'
export DSA_CHAT_RUNS_DIRECTORY="$PWD/.private-data-chat/runs"

# The trusted model is served locally through llama-server's OpenAI-compatible API.
export OPENAI_BASE_URL='http://127.0.0.1:8000/v1'
export OPENAI_API_KEY=local
export NO_PROXY="${NO_PROXY:+${NO_PROXY},}127.0.0.1,localhost"
export DSA_CHAT_TRUSTED_MODEL_NAME='openai-chat:local-dsa-model'
export DSA_CHAT_TRUSTED_MODEL_SETTINGS_JSON='{"thinking":"medium"}'

export DSA_CHAT_DOCKER_IMAGE='dsa-python@sha256:replace-with-local-image-digest'
export DSA_CHAT_REPORT_TO_MLFLOW=false
